# Credenciales ARCA (ex-AFIP)
# Copiar este archivo a .env y completar con tus datos reales

ARCA_CUIT=20123456789
ARCA_PASSWORD=tu_password_aqui

# Integración con Odoo (subida automática del Libro de Compras)
# Opcional: si se dejan vacías, el scraper solo descarga el archivo (comportamiento actual).
# ODOO_UPLOAD_URL debe apuntar al ambiente elegido (producción o staging) según corresponda.
ODOO_UPLOAD_URL=https://tu-instancia.odoo.com/l10n_ar_arca_import/upload
ODOO_API_TOKEN=
ODOO_COMPANY_ID=
