# Credenciales ARCA (ex-AFIP) — cuenta gestora/apoderada
# Copiar este archivo a .env y completar con tus datos reales

ARCA_CUIT=20123456789
ARCA_PASSWORD=tu_password_aqui

# Integración con Odoo (subida automática del Libro de Compras)
# Opcional: si se dejan vacías, el scraper solo descarga los archivos
# (comportamiento actual, sin subir a Odoo).
# ODOO_UPLOAD_URL debe apuntar al ambiente elegido (producción o staging) según corresponda.
# El company_id de Odoo de cada empresa va en config/empresas.json, no acá.
ODOO_UPLOAD_URL=https://tu-instancia.odoo.com/l10n_ar_arca_import/upload
ODOO_API_TOKEN=tu_token_aqui

# Ajustes -> Tecnico -> Parámetros del sistema. Agregar estas dos claves
# - l10n_ar_import_arca_excel.api_token = un secreto largo y random (por ejemplo openssl rand -hex 32).
# - l10n_ar_import_arca_excel.notification_email = (el mail donde querés el resumen diario.)
